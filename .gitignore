pdf/
*.pdf
__pycache__/
*.pyc
.venv/
*.db
review/
assets/figures-original/
assets/figures-export/
*.code-workspace

# One-off model comparison. The conclusion is recorded in the design notes;
# the artifacts are 4.5 MB of base64 page images.
pipeline/bakeoff/

# Derived from the committed *.raw.txt by ocrlib.normalize() — no GPU, no
# scans, regenerated automatically by emit.py when missing.
pipeline/cache/*/p*.md

# Sidecars from the shelved equation-number verifier.
pipeline/cache/*/*.eqnums.json

# Editorial reports — regenerated by `run.py --chapter chN --from edit`.
pipeline/reports/
# Unit registry, rebuilt by units.py whenever preamble.typ changes.
pipeline/cache/units-verified.json
# Pilot output from `emit.py --out NAME`, for comparing a run against hand edits.
src/chapters/*-pilot.typ

# Margin-number reads, cached per page by edit.py — a vision call each.
pipeline/cache/*/p*.margins.json

# Scratch chapter output from pipeline testing (emit --out / edit --file).
src/chapters/*-test.typ
